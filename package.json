{
  "name": "biometric-payment-system",
  "version": "1.0.0",
  "description": "Merchant-initiated biometric payment API using Node.js, TypeScript, and PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "build:all": "npm run build && npm run build:web",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node ./node_modules/jest/bin/jest.js --detectOpenHandles --runInBand",
    "db:create-test": "node scripts/create-test-database.js",
    "db:reconcile": "node scripts/reconcile-database.js",
    "db:verify": "node scripts/verify-database.js",
    "db:migrate": "node scripts/migrate.js",
    "integration:test": "node ./node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5",
    "vite": "^7.1.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7"
  }
}
